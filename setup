#!/bin/bash

if [[ " $@ " =~ " DOCKER " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "DOCKER INSTALL"
  sudo pacman -Suy docker
  sudo groupadd docker
  sudo usermod -aG docker $USER
  newgrp docker
fi

if [[ " $@ " =~ " MINIKUBE " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "MINIKUBE INSTALL"
  curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube-latest.x86_64.rpm
  sudo rpm -Uvh minikube-latest.x86_64.rpm
  rm minikube-latest.x86_64.rpm
fi

if [[ " $@ " =~ " ZSH " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "OHMYZSH INSTALL"
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

  echo "ZSH PLUGINS"
  git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions

  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k

  git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting

  chsh -s $(which zsh)
fi

if [[ " $@ " =~ " PYTHON " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "PYENV INSTALL"
  curl https://pyenv.run | bash
fi

if [[ " $@ " =~ " PACMAN " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "PACMAN PACKAGES"
  sudo pacman -S - < pacman-packages
fi

if [[ " $@ " =~ " DOTS " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "STOWING DOT FILES"
  git submodule update --init --recursive

  stow -R fonts zsh alacritty tmux scripts
fi


if [[ " $@ " =~ " TMUX " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "TMUX CONFIG"

  git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm

fi
if [[ " $@ " =~ " JETBRAINS " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "JETRBAINS TOOLBOX AND IDEAVIM"
  wget https://download.jetbrains.com/toolbox/jetbrains-toolbox-2.5.2.35332.tar.gz -P /tmp/
  tar -xzf /tmp/jetbrains-toolbox-2.5.2.35332.tar.gz -C /tmp
  mv /tmp/**/jetbrains-toolbox ~/Toolbox
  ~/Toolbox/jetbrains-toolbox
  stow -R ideavim
fi

if [[ " $@ " =~ " YAY " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "YAY INSTALL"
  sudo pacman -S --needed git base-devel && git clone https://aur.archlinux.org/yay.git && cd yay && makepkg -si
fi

if [[ " $@ " =~ " YAY_PACKAGES " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "YAY PACKAGES"
  # deliberately split on all whitespace, but don't do globbing
  yay -S - < yay-packages
fi

if [[ " $@ " =~ " KDE " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "KONSAVE IMPORT"
  # Run the commands if "KDE" is found in the arguments
  konsave -i ./thinkpad-a.knsv
  konsave -a thinkpad-a
fi


if [[ " $@ " =~ " SWAY " ]] || [[ " $@ " =~ " ALL " ]]; then
  echo "SWAY SETUP"
  yay -Syu sway xclip clipman slurp azote grim swaylock swaybg wmenu waybar swaync fuzzel tmux nvim

  stow -S sway waybar scripts zsh2 tmux kickstart fuzzel
fi

echo "DONE"
