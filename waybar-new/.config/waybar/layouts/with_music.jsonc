{
    "layer": "top",
    "position": "top",
    "height": 25,
    "margin": "2 50",

    "group/left" : {
        "orientation": "horizontal",
        "modules" : [
            "sway/workspaces",
            "sway/window",
            "mpris"
        ]
    },

    "group/left-hidden" : {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules" : [
            "custom/arrow-right", "battery", "cpu", "load", "memory", "network#bandwidth"
        ]
    },

    "group/left-hidden-top" : {
        "orientation": "horizontal",
        "modules" : [ "custom/start", "group/left-hidden" ]
    },

    "group/right" : {
        "orientation": "horizontal",
        "modules" : [
           "custom/mako", "bluetooth", "pulseaudio#input", "group/group-volume", "tray"
        ]
    },

    "modules-left"   : ["group/left-hidden-top", "group/left"],
    "modules-center" : ["clock"],
    "modules-right"  : ["group/right"],

    "include": [ "~/.config/waybar/modules.jsonc" ]
}
